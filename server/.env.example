# Copie para server/.env (ignorado pelo Git) e preencha localmente.
DB_HOST=
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=
# Valor aleatório exclusivo, com pelo menos 32 bytes. Nunca versionar.
SESSION_SECRET=
# Limites operacionais de upload (bytes), opcionais; nao sao requisitos da ERS.
UPLOAD_MAX_BYTES=10485760
UPLOAD_MULTIPART_MAX_BYTES=10616832
UPLOAD_MAX_FIELDS=8
UPLOAD_FIELD_MAX_BYTES=8192
UPLOAD_EXPANDED_MAX_BYTES=67108864

# Operação P03: origens completas sem barra final; somente dados públicos aqui.
NODE_ENV=development
APP_ORIGIN=
API_PUBLIC_ORIGIN=
CORS_ORIGINS=
# Produção exige IP/subrede explícitos do proxy e SESSION_STORE=mysql.
TRUST_PROXY=
SESSION_STORE=mysql

# Recuperação P40: contato por conta confirmado via API administrativa.
RECOVERY_PUBLIC_ORIGIN=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
